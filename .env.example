# Copy to .env and fill in. .env is git-ignored.

# Required
DISCORD_TOKEN=your-bot-token-from-discord-dev-portal
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hablemos_rs

# Optional
ENVIRONMENT=local
# Text-command prefix. Namespaced so commands are clearly identified
# as Broly. Default: rs.
COMMAND_PREFIX=rs.

# When set, slash commands register to this guild only (instant propagation).
# Unset in production so commands register globally.
# DEV_GUILD_ID=123456789012345678

# Tracing filter. Examples:
#   RUST_LOG=info
#   RUST_LOG=hablemos_rs=debug,serenity=info
RUST_LOG=info,hablemos_rs=debug,serenity=warn

# Only used at `cargo sqlx prepare` time for offline builds
# SQLX_OFFLINE=true
